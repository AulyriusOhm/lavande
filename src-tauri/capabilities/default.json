{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacités par défaut de Lavande",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }]
    },
    "core:window:allow-create",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "updater:default",
    "lavandeupdater:default",
    "lavandebgsync:default",
    "lavandeattachments:default",
    "process:default"
  ]
}