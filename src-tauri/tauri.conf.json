{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lavande",
  "version": "0.1.0",
  "identifier": "mail.lavande.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lavande",
        "width": 1100,
        "height": 780,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
