{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lavande",
  "version": "0.1.0",
  "identifier": "mail.lavande.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:distribution",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lavande",
        "width": 1100,
        "height": 780,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFQTI0MTNFRjlGNkUxN0IKUldSNzRmYjVQa0dpL2t2bEdaL2pHQXBYZlFSU3N2ZU5lbVpraE81YjJqbHBBZUFwaVlXdDNGK1kK",
      "endpoints": ["https://lavande.mail/updates/latest.json"],
      "requireSignedVersion": true
    }
  }
}
