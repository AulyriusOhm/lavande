{
  "name": "lavande",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:portal": "VITE_BASE=/lavande/ vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "node scripts/e2e-sync.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "tauri": "tauri",
    "android:init": "tauri android init && node scripts/patch-android.mjs",
    "android:build": "bash scripts/build-android-release.sh",
    "android:build:debug": "node scripts/patch-android.mjs && tauri android build --debug --apk",
    "mail:fmt": "cargo fmt --all -- --check",
    "mail:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "mail:test": "cargo test --workspace",
    "mail:test:live": "MAIL_TEST_TLS_DIR=$HOME/.cache/lavande/mail-test cargo test --workspace --test live -- --ignored --test-threads=1"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "marked": "^18.2.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
