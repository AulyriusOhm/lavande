{
  "name": "lavande",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:portal": "VITE_BASE=/lavande/ vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "tauri": "tauri",
    "mail:fmt": "cargo fmt --all -- --check",
    "mail:clippy": "cargo clippy -p lavande-mail --all-targets -- -D warnings",
    "mail:test": "cargo test -p lavande-mail",
    "mail:test:live": "MAIL_TEST_TLS_DIR=$HOME/.cache/lavande/mail-test cargo test -p lavande-mail --test live -- --ignored --test-threads=1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
