# Copier en `.env` puis ajuster si besoin. Toutes les variables sont optionnelles :
# les valeurs ci-dessous sont les valeurs par défaut du serveur.
LAVANDE_SYNC_DATABASE_URL=postgres://lavande:lavande@127.0.0.1:55432/lavande_sync
LAVANDE_SYNC_BIND_ADDR=127.0.0.1:8787
LAVANDE_SYNC_SERVER_MAX_SCHEMA=1
LAVANDE_SYNC_MIN_CLIENT_SCHEMA=1
LAVANDE_SYNC_PAIRING_TTL_SECS=300
LAVANDE_SYNC_SESSION_TTL_SECS=2592000
# Liste d'origines séparées par des virgules ; vide = aucune origine externe autorisée.
LAVANDE_SYNC_CORS_ORIGINS=
RUST_LOG=info
