<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.1">
  <emailProvider id="lanro.eu">
    <domain>mail.lanro.eu</domain>
    <domain>lanro.eu</domain>
    <displayName>Courrier lanro.eu</displayName>
    <displayShortName>lanro.eu</displayShortName>
    <incomingServer type="imap">
      <hostname>mail.lanro.eu</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>mail.lanro.eu</hostname>
      <port>587</port>
      <socketType>STARTTLS</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>
  </emailProvider>
  <clientConfigUpdate url="https://autoconfig.lanro.eu/mail/config-v1.1.xml"/>
</clientConfig>
